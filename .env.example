# Copy this file to .env and fill values locally.
# .env is ignored by git. Never commit real private keys or API secrets.

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=http://127.0.0.1:7890

# Polymarket public data API
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_PROXY_URL=http://127.0.0.1:7890

# Polymarket external executor credentials.
# These are read by the executor command passed to --weatherhk-auto-copy-exec.
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_AUTH_MODE=derive
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2

# Optional CLOB API credentials if your executor needs pre-derived keys.
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_SECRET=
POLYMARKET_CLOB_PASSPHRASE=

# WeatherHK auto-copy defaults
WEATHERHK_AUTO_COPY_ENABLED=false
WEATHERHK_AUTO_COPY_MODE=dry-run
WEATHERHK_AUTO_COPY_EXEC=./scripts/polymarket_executor.sh
WEATHERHK_STATE_PATH=logs/weatherhk_autocopy_state.json
WEATHERHK_MAX_SINGLE_COPY_USD=10
WEATHERHK_MAX_MARKET_EXPOSURE_USD=50
WEATHERHK_MAX_DAILY_SPEND_USD=200
WEATHERHK_MAX_DAILY_LOSS_USD=50
WEATHERHK_MAX_CHASE_PCT=0.15
WEATHERHK_PASSIVE_OFFSET_PCT=0.05
WEATHERHK_MAX_CHASE_DELTA=0.03
WEATHERHK_PASSIVE_OFFSET=0.02
WEATHERHK_BUY_TAKE_ENABLED=true
WEATHERHK_MIN_BUY_SOURCE_NOTIONAL_USD=1
WEATHERHK_SKIP_BUY_PRICE_AT_OR_ABOVE=0.98
WEATHERHK_SKIP_BUY_PRICE_AT_OR_BELOW=0.005
WEATHERHK_MIN_SELL_SYNC_NOTIONAL_USD=1
WEATHERHK_PASSIVE_TTL_SECONDS=0
WEATHERHK_STARTUP_BACKFILL_SECONDS=1800
WEATHERHK_PENDING_SYNC_SECONDS=30
WEATHERHK_SELL_FRACTION=0.50
WEATHERHK_CLEAR_SELL_NOTIONAL_USD=60
WEATHERHK_FAILED_ACTION_COOLDOWN_SECONDS=900
WEATHERHK_SOURCE_FLOW_WINDOW_SECONDS=120
WEATHERHK_POST_SELL_BUY_GUARD_SECONDS=120
WEATHERHK_SOURCE_PRESSURE_COOLDOWN_SECONDS=300
WEATHERHK_SOURCE_PRESSURE_MIN_SELL_COUNT=3
WEATHERHK_SOURCE_PRESSURE_MIN_SELL_NOTIONAL_USD=3
WEATHERHK_SOURCE_PRESSURE_MAX_AVG_SELL_GAP_SECONDS=30
WEATHERHK_SOURCE_REENTRY_ALERT_BUY_USD=30
